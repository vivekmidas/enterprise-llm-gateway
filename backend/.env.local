# ======================
# Application Settings
# ======================
DEBUG=true
ENVIRONMENT=development
TRACE_LOGGING=true

# ======================
# Server Settings
# ======================
HOST=49.207.54.166
PORT=8000

# ======================
# LLM Configuration (vLLM Recommended)
# ======================
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=EMPTY

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ======================
# Database (Future)
# ======================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llm_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ======================
# Redis (for caching + LangGraph checkpointer)
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# Security & Logging
# ======================
SECRET_KEY=super-secret-change-this-in-production
LOG_LEVEL=INFO

# ======================
# Presidio / Guardrails
# ======================
DEFAULT_PII_ENTITIES=PHONE_NUMBER,EMAIL_ADDRESS,PERSON,CREDIT_CARD,PII_PASSWORD
GUARD_SCORE_THRESHOLD=0.65