# ======================
# Application Settings
# ======================
DEBUG=true
ENVIRONMENT=development
TRACE_LOGGING=true

# ======================
# Server Settings
# ======================
HOST=0.0.0.0
PORT=8000

# ======================
# LLM Configuration (vLLM Recommended)
# ======================
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ======================
# Database (MySQL)
# ======================
# Updated database setting to MySQL async URL
DATABASE_URL=mysql+aiomysql://root:rootpassword@localhost:3306/enterprise_gateway
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=enterprise_gateway
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

# ======================
# Redis (for caching + LangGraph checkpointer)
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# Security & Logging
# ======================
SECRET_KEY=super-secret-change-this-in-production
LOG_LEVEL=INFO

# ======================
# Presidio / Guardrails
# ======================
DEFAULT_PII_ENTITIES=PHONE_NUMBER,EMAIL_ADDRESS,PERSON,CREDIT_CARD,PII_PASSWORD
GUARD_SCORE_THRESHOLD=0.65