{
    "name": "ollama_node",
    "label": "Ollama Chat",
    "node_type": "NODE",
    "description": "Executes chat completions on local or remote Ollama server using tenant-configured LLM profile.",
    "version": "2.0.4",
    "category": "voice",
    "group": "LLM",
    "icon": "bot",
    "color": "#FF8C00",
    "badge": "Ollama",
    "sub_label": "Local Engine",
    "file_name": "ollama_node.py",
    "class_name": "OllamaNode",
    "user_properties": [
        {
            "key": "profile_name",
            "type": "source",
            "label": "LLM Profile",
            "source": "/api/llm-profiles",
            "description": "Select tenant-configured LLM profile for Ollama host URL, model, and authentication settings."
        },
        {
            "key": "system_prompt",
            "type": "textarea",
            "label": "System Prompt",
            "default": "You are a helpful assistant.",
            "description": "System prompt instructions for the LLM."
        },
        {
            "key": "user_prompt",
            "type": "textarea",
            "label": "User Prompt Template",
            "default": "",
            "description": "Optional prompt template. Supports variables like {{ input_data }}."
        },
        {
            "key": "temperature",
            "type": "number",
            "label": "Temperature",
            "default": 0.7,
            "description": "Sampling temperature (0.0 to 1.0)."
        },
        {
            "key": "max_tokens",
            "type": "number",
            "label": "Max Tokens",
            "default": 1024,
            "description": "Maximum completion tokens to generate."
        }
    ],
    "system_properties": [
        {
            "key": "base_url",
            "type": "string",
            "label": "Fallback Base URL",
            "default": "http://127.0.0.1:11434",
            "description": "Default base URL for the Ollama server when no profile is configured."
        },
        {
            "key": "default_model",
            "type": "string",
            "label": "Default Model",
            "default": "llama3.2",
            "description": "Fallback model name when not specified in profile or node."
        },
        {
            "key": "api_key",
            "type": "password",
            "label": "API Key",
            "default": "ollama",
            "description": "Authorization token or password if Ollama is reverse-proxied."
        },
        {
            "key": "timeout_seconds",
            "type": "number",
            "label": "Timeout (seconds)",
            "default": 60,
            "description": "HTTP request timeout limit."
        },
        {
            "key": "max_retries",
            "type": "number",
            "label": "Max Retries",
            "default": 3,
            "description": "Number of retry attempts on request failure."
        }
    ],
    "input_contract": {
        "type": "object",
        "properties": {
            "prompt": {
                "type": "string",
                "description": "The main user instruction or query."
            },
            "query": {
                "type": "string",
                "description": "Alias for prompt input."
            },
            "context": {
                "type": "string",
                "description": "Optional context string from upstream knowledge retrieval."
            },
            "system_prompt_override": {
                "type": "string",
                "description": "Optional system prompt override."
            },
            "history": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "role": {
                            "type": "string",
                            "enum": ["system", "user", "assistant"]
                        },
                        "content": {
                            "type": "string"
                        }
                    },
                    "required": ["role", "content"]
                },
                "description": "Optional conversation history list."
            }
        },
        "required": ["prompt"]
    },
    "output_contract": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "Cleaned response string returned by the LLM."
            },
            "answer": {
                "type": "string",
                "description": "Alias for text string."
            },
            "usage": {
                "type": "object",
                "properties": {
                    "prompt_tokens": {
                        "type": "integer",
                        "default": 0
                    },
                    "completion_tokens": {
                        "type": "integer",
                        "default": 0
                    },
                    "total_tokens": {
                        "type": "integer",
                        "default": 0
                    }
                }
            }
        },
        "required": ["text"]
    }
}
