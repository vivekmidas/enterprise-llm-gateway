{
    "name": "ollama_node",
    "label": "Ollama Node",
    "node_type": "NODE",
    "description": "Executes LLM operations (chat, search, embedding, reranking) on an Ollama server with optional Knowledge Base retrieval.",
    "version": "1.2.0",
    "category": "brain",
    "group": "LLM",
    "icon": "bot",
    "color": "#FF8C00",
    "badge": "Ollama",
    "sub_label": "Local Engine",
    "file_name": "ollama_node.py",
    "class_name": "OllamaNode",
    "user_properties": [
        {
            "key": "llm_profile_id",
            "type": "source",
            "label": "LLM Profile",
            "source": "/api/llm-profiles",
            "description": "Select LLM Profile for endpoint URL, model, and authentication settings."
        },
        {
            "key": "knowledge_base_ids",
            "type": "source",
            "label": "Knowledge Bases",
            "source": "/api/knowledge/bases",
            "options": [],
            "multiple": true,
            "description": "Select Knowledge Bases to query for context retrieval."
        },
        {
            "key": "system_prompt",
            "type": "textarea",
            "label": "System Prompt",
            "default": "You are a helpful assistant.",
            "description": "System prompt instructions for the LLM."
        },
        {
            "key": "user_prompt",
            "type": "textarea",
            "label": "User Prompt Template",
            "default": "",
            "description": "Optional prompt template override. Can use {{ input_data }} placeholders."
        },
        {
            "key": "temperature",
            "type": "number",
            "label": "Temperature",
            "default": 0.7,
            "description": "Sampling temperature (0.0 to 1.0)."
        },
        {
            "key": "max_tokens",
            "type": "number",
            "label": "Max Tokens",
            "default": 1024,
            "description": "Maximum completion tokens to generate."
        },
        {
            "key": "top_k",
            "type": "number",
            "label": "Top K Chunks",
            "default": 5,
            "description": "Number of relevant text chunks to retrieve from Knowledge Bases."
        },
        {
            "key": "score_threshold",
            "type": "number",
            "label": "Score Threshold",
            "default": 0.0,
            "description": "Minimum similarity score threshold (0.0 to 1.0)."
        }
    ],
    "system_properties": [
        {
            "key": "timeout_seconds",
            "type": "number",
            "label": "Timeout (seconds)",
            "default": 60,
            "description": "HTTP request timeout limit."
        },
        {
            "key": "max_retries",
            "type": "number",
            "label": "Max Retries",
            "default": 3,
            "description": "Number of retry attempts on request failure."
        }
    ],
    "input_contract": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "Alias for prompt input."
            },
            "prompt": {
                "type": "string",
                "description": "User prompt, query, or text input for chat, search, embedding, or reranking."
            },
            "history": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "role",
                        "content"
                    ],
                    "properties": {
                        "role": {
                            "enum": [
                                "system",
                                "user",
                                "assistant"
                            ],
                            "type": "string"
                        },
                        "content": {
                            "type": "string"
                        }
                    }
                },
                "description": "Optional conversation history list for chat mode."
            },
            "documents": {
                "type": "array",
                "description": "Candidate document strings or dict objects for reranking mode."
            },
            "knowledge_base_ids": {
                "type": "array",
                "items": {
                    "type": "integer"
                },
                "description": "Optional Knowledge Base IDs to query for RAG retrieval."
            },
            "system_prompt_override": {
                "type": "string",
                "description": "Optional system prompt override for chat and search modes."
            }
        }
    },
    "output_contract": {
        "type": "object",
        "required": [
            "text"
        ],
        "properties": {
            "text": {
                "type": "string",
                "description": "Clean primary string response generated by LLM, embedding json, or reranked results."
            },
            "query": {
                "type": "string",
                "description": "Original query or prompt string."
            },
            "usage": {
                "type": "object",
                "properties": {
                    "total_tokens": {
                        "type": "integer",
                        "default": 0
                    },
                    "prompt_tokens": {
                        "type": "integer",
                        "default": 0
                    },
                    "completion_tokens": {
                        "type": "integer",
                        "default": 0
                    }
                }
            },
            "answer": {
                "type": "string",
                "description": "Alias for text string to support downstream nodes expecting answer."
            },
            "chunks": {
                "type": "array",
                "description": "List of retrieved KB text chunks."
            },
            "result": {
                "type": "object",
                "description": "Downstream mapping container object."
            },
            "context": {
                "type": "string",
                "description": "Retrieved context string if KB search was executed."
            },
            "results": {
                "type": "array",
                "description": "List of ranked document objects (populated for reranking mode)."
            },
            "citations": {
                "type": "array",
                "description": "List of citation metadata objects."
            },
            "embedding": {
                "type": "array",
                "description": "Float array containing embedding vector (populated for embedding mode)."
            }
        }
    }
}