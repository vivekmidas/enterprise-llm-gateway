{
    "name": "generic_mysql_query_executor",
    "label": "MySQL ",
    "node_type": "TOOL",
    "description": "Executes SQL queries on MySQL databases. Supports parameterized queries and Jinja templating.",
    "version": "1.0.4",
    "category": "database",
    "group": "Data",
    "icon": "database",
    "color": "#5E0CEC",
    "badge": "Node",
    "sub_label": null,
    "file_name": "generic_mysql_node.py",
    "class_name": "GenericMySQLDBExecutor",
    "user_properties": [
        {"key": "allow_node_testing", "type": "boolean", "label": "allow_node_testing", "value": true, "default": true, "description": ""},
        {"key": "username", "type": "string", "label": "username", "value": "", "default": "", "description": "Database username"},
        {"key": "password", "type": "password", "label": "password", "value": "", "default": "", "description": "Database password"}
    ],
    "system_properties": [
        {"key": "host", "type": "string", "label": "host", "value": "", "default": "", "description": "Database host / IP address"},
        {"key": "port", "type": "integer", "label": "port", "value": 3306, "default": 3306, "description": "Database port"},
        {"key": "server", "type": "string", "label": "server", "value": "", "default": "", "description": "server address or qualified domain name"},
        {"key": "database", "type": "string", "label": "database", "value": "", "default": "", "description": "Target database name"}
    ],
    "input_contract": {
        "version": "1.0",
        "rules": [
            {"field_name": "query_type", "field_type": "string", "required": false, "allowed_values": ["select", "insert", "update", "delete", "raw"], "default": "select", "description": "SQL operation type (select, insert, update, delete, raw)"},
            {"field_name": "query", "field_type": "string", "required": false, "description": "Raw SQL query string (used when query_type is raw)"},
            {"field_name": "table_name", "field_type": "string", "required": false, "description": "Target database table name"},
            {"field_name": "fields", "field_type": "object", "required": false, "description": "Key-value column map for insert/update"},
            {"field_name": "field_names", "field_type": "array", "required": false, "description": "Column names to select or insert"},
            {"field_name": "field_values", "field_type": "array", "required": false, "description": "Values corresponding to field_names"},
            {"field_name": "condition", "field_type": "string", "required": false, "description": "SQL WHERE clause condition (e.g. id = %s)"},
            {"field_name": "condition_params", "field_type": "array", "required": false, "description": "Parameters for WHERE clause placeholders"},
            {"field_name": "params", "field_type": "object", "required": false, "description": "Named parameters for raw SQL query"}
        ],
        "additional_fields": false
    },
       "output_contract":  {
        "version": "1.0",
        "rules": [
            {"field_name": "data", "field_type": "array", "required": false},
            {"field_name": "rowcount", "field_type": "integer", "required": false},
            {"field_name": "lastrowid", "field_type": "integer", "required": false}
        ],
        "additional_fields": true
    }
}